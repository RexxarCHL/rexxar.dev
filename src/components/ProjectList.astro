---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

{projects.map((p) => (
  <article class="entry">
    <div class="entry-head">
      <h3><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
      <span class="meta">{p.data.date}</span>
    </div>
    <p class="meta">{p.data.org}</p>
    <p>{p.data.summary}</p>
  </article>
))}
