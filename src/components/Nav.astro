---
interface Props {
  /** Prefix for in-page anchors, so links work from sub-pages too. */
  base?: string;
}
const { base = '' } = Astro.props;
const items = [
  { label: 'About', href: `${base}#about` },
  { label: 'Experience', href: `${base}#experience` },
  { label: 'Projects', href: `${base}#projects` },
  { label: 'Contact', href: `${base}#contact` },
];
---

<input id="menu-checkbox" type="checkbox" class="sr-only menu-checkbox" aria-label="Menu" />
<nav class="nav" data-nav>
  <div class="container nav-inner">
    <a href="/" class="logo">REXXAR</a>
    <div class="nav-links">
      {items.map((i) => <a href={i.href}>{i.label.toUpperCase()}</a>)}
    </div>
    <div class="nav-right">
      <label class="hamburger" for="menu-checkbox" aria-hidden="true">
        <span class="bar bar--top"></span>
        <span class="bar bar--middle"></span>
        <span class="bar bar--bottom"></span>
      </label>
      <label class="theme-toggle" title="Toggle light/dark mode">
        <input type="checkbox" class="theme-input sr-only" data-theme-toggle aria-label="Dark mode" />
        <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <mask id="moon-mask">
            <rect x="0" y="0" width="20" height="20" fill="white"></rect>
            <circle cx="11" cy="3" r="8" fill="black"></circle>
          </mask>
          <circle class="sun-moon" cx="10" cy="10" r="8" mask="url(#moon-mask)"></circle>
          <g>
            <circle class="sun-ray" cx="18" cy="10" r="1.5"></circle>
            <circle class="sun-ray" cx="14" cy="16.928" r="1.5"></circle>
            <circle class="sun-ray" cx="6" cy="16.928" r="1.5"></circle>
            <circle class="sun-ray" cx="2" cy="10" r="1.5"></circle>
            <circle class="sun-ray" cx="6" cy="3.1718" r="1.5"></circle>
            <circle class="sun-ray" cx="14" cy="3.1718" r="1.5"></circle>
          </g>
        </svg>
      </label>
    </div>
  </div>
</nav>
<div class="mobile-menu">
  {items.map((i) => <a href={i.href} data-close-menu>{i.label.toUpperCase()}</a>)}
</div>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 20);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const menu = document.getElementById('menu-checkbox') as HTMLInputElement | null;
  document.querySelectorAll('[data-close-menu]').forEach((a) =>
    a.addEventListener('click', () => { if (menu) menu.checked = false; }),
  );

  const toggle = document.querySelector<HTMLInputElement>('[data-theme-toggle]');
  if (toggle) {
    toggle.checked = !document.documentElement.classList.contains('light');
    toggle.addEventListener('change', () => {
      const light = !toggle.checked;
      document.documentElement.classList.toggle('light', light);
      try { localStorage.setItem('theme', light ? 'light' : 'dark'); } catch {}
    });
  }
</script>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    padding-block: 1.5rem;
    border-bottom: 1px solid transparent;
    transition: padding 0.5s var(--ease), background-color 0.5s var(--ease), border-color 0.5s var(--ease);
  }
  @media (min-width: 768px) { .nav { padding-block: 2rem; } }
  .nav.scrolled {
    padding-block: 0.75rem;
    background: color-mix(in srgb, var(--page-bg) 80%, transparent);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom-color: var(--hairline);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; position: relative; }
  .logo { font-weight: 900; letter-spacing: 0.18em; font-size: 0.95rem; text-decoration: none; }
  .nav-links {
    display: none;
    position: absolute; left: 50%; transform: translateX(-50%);
    gap: 2.5rem;
  }
  .nav-links a, .mobile-menu a {
    text-decoration: none; font-weight: 600; letter-spacing: 0.1em;
    transition: opacity 0.2s;
  }
  .nav-links a { font-size: 0.78rem; }
  .nav-links a:hover { opacity: 0.6; }
  @media (min-width: 768px) { .nav-links { display: flex; } }
  .nav-right { display: flex; align-items: center; gap: 0.9rem; }

  /* Theme toggle (sun/moon) */
  .theme-toggle { width: 2.2em; cursor: pointer; display: flex; position: relative; z-index: 60; }
  .theme-toggle svg { width: 100%; height: 100%; transform: rotate(40deg); transition: transform 0.4s ease; }
  .sun-moon { transform-origin: center; transform: scale(1); transition: transform 0.4s ease; }
  .sun-ray { transform-origin: center; transform: scale(0); }
  .theme-toggle mask > circle { transition: transform 0.64s cubic-bezier(0.41, 0.64, 0.32, 1.575); }
  .theme-input:not(:checked) + svg { transform: rotate(90deg); }
  .theme-input:not(:checked) + svg mask > circle { transform: translate(16px, -3px); }
  .theme-input:not(:checked) + svg .sun-moon { transform: scale(0.55); }
  .theme-input:not(:checked) + svg .sun-ray { animation: show-ray 0.4s ease forwards; }
  .theme-input:focus-visible + svg { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 4px; }
  @keyframes show-ray { to { transform: scale(1); } }

  /* Hamburger + mobile overlay */
  .hamburger {
    position: relative; width: 28px; height: 19px; cursor: pointer; display: block; z-index: 60;
  }
  @media (min-width: 768px) { .hamburger, .mobile-menu { display: none !important; } }
  .bar {
    position: absolute; left: 0; right: 0; height: 3px; border-radius: 2px;
    background: var(--page-fg);
    transition: transform 0.35s cubic-bezier(.5,-0.35,.35,1.5), top 0.35s, opacity 0.2s;
  }
  .bar--top { top: 0; }
  .bar--middle { top: 8px; }
  .bar--bottom { top: 16px; }
  .menu-checkbox:checked ~ .nav .hamburger .bar--top { top: 8px; transform: rotate(45deg); }
  .menu-checkbox:checked ~ .nav .hamburger .bar--middle { opacity: 0; }
  .menu-checkbox:checked ~ .nav .hamburger .bar--bottom { top: 8px; transform: rotate(-45deg); }
  .menu-checkbox:focus-visible ~ .nav .hamburger { outline: 2px solid currentColor; outline-offset: 6px; }
  .mobile-menu {
    position: fixed; inset: 0; z-index: 40;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rem;
    background: var(--page-bg);
    opacity: 0; pointer-events: none;
    transition: opacity 0.3s;
  }
  .mobile-menu a { font-size: 1.75rem; }
  .menu-checkbox:checked ~ .mobile-menu { opacity: 1; pointer-events: auto; }
</style>
