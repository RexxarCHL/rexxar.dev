---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../data/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, org, date, tags, summary, links } = project.data;
---

<Base title={title} description={summary}>
  <main class="container page">
    <a class="back" href="/projects/">← All projects</a>
    <header class="head fade-in">
      <span class="cat">{org} · {date}</span>
      <h1 class="gradient-text">{title}</h1>
      <ul class="pills tags">
        {tags.map((t) => <li class="pill">{t}</li>)}
      </ul>
    </header>
    <article class="prose fade-in" style="--delay: 0.1s">
      <Content />
    </article>
    {links.length > 0 && (
      <ul class="links fade-in" style="--delay: 0.2s">
        {links.map((l) => (
          <li><a class="btn" href={l.url} target="_blank" rel="noreferrer">{l.label} ↗</a></li>
        ))}
      </ul>
    )}
  </main>
</Base>

<style>
  .page { padding-top: 8rem; padding-bottom: 6rem; max-width: 48rem; }
  .back { display: inline-block; text-decoration: none; opacity: 0.6; font-size: 0.9rem; margin-bottom: 2.5rem; }
  .back:hover { opacity: 1; }
  .head { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 3rem; }
  .cat { text-transform: uppercase; letter-spacing: 0.12em; font-weight: 300; opacity: 0.6; font-size: 0.85rem; }
  h1 { font-weight: 900; text-transform: uppercase; font-size: clamp(2rem, 6vw, 4rem); line-height: 1; letter-spacing: -0.01em; }
  .tags { justify-content: flex-start; }
  .prose { font-weight: 300; font-size: clamp(1rem, 1.5vw, 1.15rem); line-height: 1.8; }
  .prose :global(p), .prose :global(ul) { margin: 0 0 1.4rem; }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(a) { text-underline-offset: 0.2em; }
  .links { list-style: none; padding: 0; margin: 3rem 0 0; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .links .btn { padding: 0.65rem 1.25rem; font-weight: 500; }
</style>
